# Pins for the Talos harness (plan 15-01). KEY=VALUE only, no commands: this file
# is sourced by bash and read by check-talos.sh. Refresh with talos/refresh-pins.sh.
# A value of UNPINNED_UNTIL_REFRESH is allowed only while talos/PINS-PENDING exists.

# Newest GA minor at execution time that supports the Kubernetes minor already
# running (v1.36). Re-check the Talos support matrix when this changes.
TALOS_VERSION=v1.14.2
K8S_VERSION=v1.36.4
FACTORY_URL=https://factory.talos.dev

# talosctl-linux-amd64 from github.com/siderolabs/talos/releases/download/<TALOS_VERSION>/
TALOSCTL_SHA256=c6c9552b0e5f767352c595fa1c0af4f186f697488646872955057d23990a66c4

# kubectl from https://dl.k8s.io/release/<KUBECTL_VERSION>/bin/linux/amd64/kubectl
KUBECTL_VERSION=v1.36.4
KUBECTL_SHA256=8b8f088da2dab964f853b38464033b1be15ede2839eca751482357c45abdd05a

# sops (single binary) and age (tarball), used by the plan 15-02 jobs.
SOPS_VERSION=v3.10.2
SOPS_SHA256=79b0f844237bd4b0446e4dc884dbc1765fc7dedc3968f743d5949c6f2e701739
AGE_VERSION=v1.2.1
AGE_SHA256=7df45a6cc87d4da11cc03a539a7470c15b1041ab2b396af088fe9990f7c79d50

# Schematic ids: POST talos/schematics/<name>.yaml to $FACTORY_URL/schematics.
# ISO hashes: sha256 of $FACTORY_URL/image/<id>/<TALOS_VERSION>/metal-amd64.iso
SCHEMATIC_BASE_ID=376567988ad370138ad8b2698212367b8edcb69b5fd68c80be1f2ec7d603b4ba
ASSET_BASE_ISO_SHA256=76ce9cf117483859460bc0523452fd3031d71fa79b5dbcd471ee3cb35cfb42ca
SCHEMATIC_MINI01_ID=65e39d025c1b86eaeed757a88e5e15670235b624f12a744dc4542224635653ac
ASSET_MINI01_ISO_SHA256=0f6ebf0f56b1b397ae3e9b65225b068e500dd42563fec72c69b2e82d2dab30fe
# Secure Boot (UKI) ISO: plan 15-07 Task 3 computes this hash on the first fetch
# (fetch-assets.sh exits 3 and prints it); the operator reviews it and pins it here.
ASSET_MINI01_ISO_SECUREBOOT_SHA256=bc3909188c29b8c6e544d706b4ca770c54ea3219c7626e295647fc79c2ea2b88
SCHEMATIC_MINI02_ID=344b018038f12191f3b0fd79c98851f1cb6a61475517e28399ef2585c929aaa3
ASSET_MINI02_ISO_SHA256=0db5a77e3e9841b0549861ea674855107f0fb243048ac0e42d5936ae3a75954e
ASSET_MINI02_ISO_SECUREBOOT_SHA256=UNPINNED_UNTIL_FIRST_FETCH

# Plan 15-04: the base schematic plus one extension, for the upgrade-adds-an-
# extension case. (Schematic file names are lowercase letters and digits only so
# the key names below stay valid shell variables.)
SCHEMATIC_UPGRADETARGET_ID=2d61dd07b20062062ea671b4d01873506103b67c0f7a4c3fb6cf4ee85585dcb8
ASSET_UPGRADETARGET_ISO_SHA256=ab6396a1680964412e71dd9e97d449044c6ae8986104558dba4b7d8391a481fb

# Plan 15-04 test images and the local-path provisioner release manifest:
# https://raw.githubusercontent.com/rancher/local-path-provisioner/<LOCALPATH_VERSION>/deploy/local-path-storage.yaml
# refresh-pins.sh checks that the tag exists and computes the hash.
LOCALPATH_VERSION=v0.0.31
# Argo CD Helm chart (argo/argo-cd) installed in the CI clusters by talos/install-argocd.sh;
# the first platform-sync run fails clearly if the version does not exist.
ARGOCD_CHART=10.9.2
LOCALPATH_MANIFEST_SHA256=bed8d03e3e07e03d3dd3e4e2150ea6eb03f8753bd317bfeb1bfa49e9b432f78d
ALPINE_TAG=3.22
PAUSE_TAG=3.10

SCHEMATIC_MINI03_ID=7d4c31cbd96db9f90c874990697c523482b2bae27fb4631d5583dcd9c281b1ff
ASSET_MINI03_ISO_SHA256=9586dd11b10b372306283a3bc75f160602a2261e2efe668b0dfa64cd43841def
