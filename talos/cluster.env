# Cluster-wide values read by render.sh (KEY=VALUE, whitelisted keys only).
# ENDPOINT_HOST is a short name (decision D2): it must resolve from the nodes
# (a DHCP reservation or a MagicDNS short name). An address or the full tailnet
# name goes only into the untracked talos/local/cluster.local.env, never here.
CLUSTER_NAME=homelab
ENDPOINT_HOST=mini01
K8S_PORT=6443
