#!/bin/sh
# Offline stand-in for talosctl, used ONLY by the guard self-tests to exercise
# render.sh's own logic (token substitution, refusals, patch order) where the
# real talosctl is not installed. It understands just the calls render.sh makes:
#   talosctl gen secrets [--force] -o FILE
#   talosctl gen config NAME URL ... --install-image IMG --output FILE --config-patch @F ...
# and writes the patches it was given, in order, into the output file.
set -eu

[ "$1" = gen ] || { echo "fake talosctl: unsupported: $*" >&2; exit 2; }
sub="$2"
shift 2

if [ "$sub" = secrets ]; then
  out=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -o) out="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [ -n "$out" ] || exit 2
  printf 'cluster:\n  id: fake-secret-id-0123456789\n  secret: fake-secret-value-0123456789\n' >"$out"
  exit 0
fi

[ "$sub" = config ] || { echo "fake talosctl: unsupported gen $sub" >&2; exit 2; }
out=""
image=""
patches=""
while [ $# -gt 0 ]; do
  case "$1" in
    --output) out="$2"; shift 2 ;;
    --install-image) image="$2"; shift 2 ;;
    --config-patch) patches="$patches ${2#@}"; shift 2 ;;
    *) shift ;;
  esac
done
[ -n "$out" ] || exit 2
{
  echo "# fake talosctl gen config"
  echo "installImage: $image"
  for p in $patches; do
    echo "---"
    cat "$p"
  done
} >"$out"
