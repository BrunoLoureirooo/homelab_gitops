{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::velero-backups",
        "arn:aws:s3:::litestream",
        "arn:aws:s3:::immich-pg"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::velero-backups/*",
        "arn:aws:s3:::litestream/*",
        "arn:aws:s3:::immich-pg/*"
      ]
    }
  ]
}
