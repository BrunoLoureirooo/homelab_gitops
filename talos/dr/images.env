# Image pins used by the backup tooling and its CI jobs (plan 15-06).
# Sourced by bash scripts. Every image carries a tag; a digest is added by
# talos/dr/pin-images.sh (needs network and crane, skopeo or docker buildx) and
# the jobs print a warning while a digest is missing. `latest` is rejected by
# .github/scripts/check-backups-06.sh.
#
# The tags below could not be checked against the registries when this file was
# written (no network in the authoring environment): pin-images.sh fails on a
# tag that does not exist, so a wrong tag shows up on its first run.

# Checker pod for the restore drill and the CI roundtrips (installs sqlite with apk).
DRILL_IMAGE_REPO=docker.io/library/alpine
DRILL_IMAGE_TAG=3.20.3
DRILL_IMAGE_DIGEST=

# Throwaway S3 server for the CI jobs (runs outside the cluster, never the real one).
# Chainguard, like the live MinIO (it only publishes `latest`, so the digest of 2026-10-17 is the pin);
# the quay.io/minio/* images now require authentication.
CI_MINIO_IMAGE_REPO=cgr.dev/chainguard/minio
CI_MINIO_IMAGE_TAG=chainguard-2026-10-17
CI_MINIO_IMAGE_DIGEST=sha256:c93745c56fccdaf0e5dcb88999a96a65a136428beb045ef5d546255a80d747a7
CI_MC_IMAGE_REPO=cgr.dev/chainguard/minio-client
CI_MC_IMAGE_TAG=chainguard-2026-10-17
CI_MC_IMAGE_DIGEST=sha256:d8a93c5d335509ff353774eefec8f82fa2a2a975e800139702232d8be3dbe6b9

# Litestream sidecar for Vaultwarden. Version and digest are decided at execution
# time from the release page (docs/dr/talos-backups.md, "Pinning").
LITESTREAM_IMAGE_REPO=docker.io/litestream/litestream
LITESTREAM_IMAGE_TAG=0.3.13
LITESTREAM_IMAGE_DIGEST=sha256:027eda2a89a86015b9797d2129d4dd447e8953097b4190e1d5a30b73e76d8d58
