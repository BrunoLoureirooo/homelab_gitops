# Pins used by the plan 15-05 storage jobs and manifests. KEY=VALUE only, sourced
# by bash. Resolved 2026-10-12 from the upstream release pages; re-check at
# execution time and refresh with the commands in the comments.
#
# csi-driver-smb: Helm chart from the project's chart repository
# (curl -s https://raw.githubusercontent.com/kubernetes-csi/csi-driver-smb/master/charts/index.yaml | head)
CSI_SMB_CHART_REPO=https://raw.githubusercontent.com/kubernetes-csi/csi-driver-smb/master/charts
CSI_SMB_CHART_VERSION=v1.20.3
# Samba server image (servercontainers/samba, smbd only), tag and manifest digest
# from https://hub.docker.com/v2/repositories/servercontainers/samba/tags
SAMBA_IMAGE=docker.io/servercontainers/samba:smbd-only-a3.24.1-s4.23.8-r0@sha256:03bdd347ddb54577e5be499ca98c456e5f36d7d80c33819f46849ec2413b7b04
