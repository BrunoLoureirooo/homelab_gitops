# mini01: control plane. Whitelisted keys only (render.sh refuses anything else).
# Overridable per machine in the untracked talos/local/mini01.local.env.
HOSTNAME=mini01
ROLE=controlplane
SCHEMATIC=mini01
# Decision D4: the install target is the 256 GB NVMe. The 512 GB disk also
# matches this selector, which is why plan 15-07 has a human check at the
# hardware step and why the 512 is physically out of the machine at install time.
DISK_TYPE=nvme
DISK_SIZE_EXPR='>= 200GB'
# Size band (decimal GB) of the Toshiba media disk, about 320 GB.
MEDIA_MIN_GB=250
MEDIA_MAX_GB=400
# Decision D1 (b): the UKI installer image, with Secure Boot left unenforced in the
# firmware (no key enrolment). Keeps the move to Secure Boot open later without a
# reinstall. mini02 stays on the classic installer until it is decided separately.
INSTALLER=installer-secureboot
