# mini02: worker. Whitelisted keys only (render.sh refuses anything else).
# Overridable per machine in the untracked talos/local/mini02.local.env.
HOSTNAME=mini02
ROLE=worker
SCHEMATIC=mini02
# mini02 has no SSD: two 1 TB spinning disks. Talos installs on one (pinned by the `system` entry of
# secrets/disks-mini02.sops.yaml, since both match this selector) and the ZFS mirror is built from
# raw partitions on both (patches/volumes-mini02.yaml).
DISK_TYPE=hdd
DISK_SIZE_EXPR='>= 900GB'
