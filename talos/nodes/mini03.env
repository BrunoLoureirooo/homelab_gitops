# mini03: worker, a libvirt VM on the victus desktop (docs/dr/mini03.md). Runs the arr stack,
# qBittorrent behind a VPN sidecar and the second copy of the backups.
# Whitelisted keys only (render.sh refuses anything else). Not used before G2.
HOSTNAME=mini03
ROLE=worker
SCHEMATIC=mini03
# No DISK_TYPE: a virtio disk reports no meaningful type. The VM has THREE virtio disks
# (ansible/roles/victus_vm): the 64 GiB OS disk (about 69 GB), the 128 GiB backups disk (about
# 137 GB) and the 283 GiB staging disk (about 304 GB). Only the OS disk is under 100 GB, so a size
# ceiling picks the install disk and can never pick a data disk. The two data disks are claimed by
# size band in patches/volumes-mini03.yaml.
DISK_SIZE_EXPR='< 100GB'
# Floor of the size band: the ISO's read-only loop devices (4 kB to 94 MB) are also under 100 GB and
# sort before the OS disk, so without it the install targets a loop device and fails (seen on the first boot).
DISK_SIZE_MIN_GB=50
